# ---- Required for real AI reasoning (Claude API) ----
ANTHROPIC_API_KEY=
# Only for API keys not scoped to a workspace (error: "must include the anthropic-workspace-id header").
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Live web data (SerpApi). Leave empty to run on built-in demo data. ----
SERPAPI_KEY=
DEMO_MODE=false

# ---- Region defaults ----
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
AMAZON_DOMAIN=amazon.in

# ---- URLs ----
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of this backend. Must be public (e.g. an ngrok URL) for Google Lens to read uploaded images.
PUBLIC_BACKEND_URL=http://localhost:8000

# ---- Optional: Google Calendar sync (OAuth client of type "Web application") ----
# Authorized redirect URI: {PUBLIC_BACKEND_URL}/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional notification channels ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Proactive loop interval (seconds) and optional shared secret for the workspace agent
PROACTIVE_INTERVAL_S=30
AGENT_TOKEN=
